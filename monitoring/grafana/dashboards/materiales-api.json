    {
      "id": 9,
      "type": "timeseries",
      "title": "Llamadas a Inventario y Patent Sweep",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (servicio, resultado) (rate(materiales_formulas_llamadas_externas_total[5m]))",
          "legendFormat": "{{servicio}} {{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Circuit breaker",
      "description": "ABIERTO: la API responde 503 sin llamar al servicio hasta que se recupere.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (servicio) (materiales_formulas_circuito_abierto)",
          "legendFormat": "{{servicio}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CERRADO",
                  "color": "green"
                },
                "1": {
                  "text": "ABIERTO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Duración p95 de las llamadas externas",
      "description": "",
      "datasource": {
        "type": "prometheus",
