# Copiar como .env y completar. En la EC2 se crea UNA VEZ en la carpeta del despliegue;
# el pipeline no lo sobrescribe. Nunca subir el archivo .env al repositorio.

# --- Docker Compose ----------------------------------------------------------------------
# Imagen publicada por el pipeline (en minúsculas). El pipeline fija el tag en cada despliegue.
API_IMAGEN=ghcr.io/propietario-del-repo/materiales-formulas-api
API_TAG=latest

# --- Base de datos (contenedor postgres y API) ------------------------------------------
POSTGRES_DB=materiales_formulas
POSTGRES_USER=materiales
POSTGRES_PASSWORD=cambiar-esta-clave
# Solo para correr la API fuera de Docker (en Docker se usa el contenedor "postgres").
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL tiene prioridad sobre las variables POSTGRES_* si se define.
# DATABASE_URL=postgresql+asyncpg://materiales:clave@localhost:5432/materiales_formulas
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TIMEOUT_S=5

# --- Grafana ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esta-clave

# --- API ----------------------------------------------------------------------------------
ENTORNO=produccion
LOG_NIVEL=INFO
DOCS_HABILITADA=true
NOMBRE_SERVICIO=materiales-formulas

# Integraciones (timeout de 5 s y circuit breaker).
HTTP_TIMEOUT_S=5
CB_UMBRAL_FALLOS=5
CB_TIEMPO_ABIERTO_S=30
# POR ACORDAR con la célula de Inventario: URL base de su EC2.
INVENTARIO_URL=http://IP-EC2-INVENTARIO:8000
INVENTARIO_RUTA_MATERIAS_PRIMAS=/inventario/materias-primas
INVENTARIO_RUTA_ARTICULO=/inventario/articulos/{codigo}
# POR ACORDAR con la célula de Patent Sweep: URL base y ruta de la solicitud de evaluación (HU-09).
PATENT_SWEEP_URL=http://IP-EC2-PATENT-SWEEP:8000
PATENT_SWEEP_RUTA_EVALUACION=/POR-ACORDAR

# Paginación (HU-06: páginas de 10; HU-11: 50 por defecto, máximo 100 por contrato).
FORMULAS_TAMANO_PAGINA=10
APROBADAS_TAMANO_PAGINA_DEFECTO=50
