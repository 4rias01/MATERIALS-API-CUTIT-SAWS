# Copiar como .env y completar. El .env nunca se sube al repositorio (está en .gitignore).
# Solo lleva secretos y valores que cambian según el entorno; el resto de la configuración
# tiene valores por defecto en app/core/config.py.
# En la EC2 se crea una sola vez en la carpeta del despliegue; el pipeline no lo modifica.

# --- API --------------------------------------------------------------------------------
# Puerto publicado en el host (el que usan las otras células). Evitar el 8000 por defecto.
API_PUERTO_HOST=

# --- PostgreSQL (contenedor postgres y API) --------------------------------------------
POSTGRES_DB=materiales_formulas
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Grafana ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Otras células (POR ACORDAR; vacías = la integración responde "no configurada") ------
INVENTARIO_URL=
PATENT_SWEEP_URL=
PATENT_SWEEP_RUTA_EVALUACION=

# --- Solo desarrollo (no hace falta en la EC2) -------------------------------------------
# Puerto de PostgreSQL en localhost (lo publica docker-compose.override.yml).
POSTGRES_PUERTO_HOST=5433
# Para correr la API o Alembic fuera de Docker, descomentar:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
